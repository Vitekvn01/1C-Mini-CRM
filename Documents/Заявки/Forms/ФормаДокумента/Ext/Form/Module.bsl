&НаКлиенте
Процедура РаботыУслугаПриИзменении(Элемент)
	// Получаем текущую строку
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Услуга) Тогда
		// Получаем цену через серверный общий модуль (чтобы избежать ошибок клиента)
		ТекущаяСтрока.Цена = РасчетРабот.ПолучитьЦенуУслуги(ТекущаяСтрока.Услуга);
		
		// Если количество пустое, ставим 1
		Если ТекущаяСтрока.Количество = 0 Тогда
			ТекущаяСтрока.Количество = 1;
		КонецЕсли;
		
		// Считаем сумму
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	Иначе
		ТекущаяСтрока.Цена = 0;
		ТекущаяСтрока.Сумма = 0;
	КонецЕсли;
	
	ОбновитьИтог();
КонецПроцедуры   

&НаКлиенте
Процедура РаботыКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	
	// Пересчитываем сумму в строке
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	
	ОбновитьИтог();
КонецПроцедуры         

&НаКлиенте
Процедура ЗапчастиЗапчастьПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Запчасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Запчасть) Тогда
		// Берем цены с сервера
		ТекущаяСтрока.ЦенаПродажи = РасчетРабот.ПолучитьЦенуПродажиЗапчасти(ТекущаяСтрока.Запчасть);
		ТекущаяСтрока.ЦенаЗакупки = РасчетРабот.ПолучитьЦенуЗакупкиЗапчасти(ТекущаяСтрока.Запчасть);
		
		Если ТекущаяСтрока.Количество = 0 Тогда
			ТекущаяСтрока.Количество = 1;
		КонецЕсли;
		
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаПродажи;
	Иначе
		ТекущаяСтрока.ЦенаПродажи = 0;
		ТекущаяСтрока.ЦенаЗакупки = 0;
		ТекущаяСтрока.Сумма = 0;
	КонецЕсли;
	
	ОбновитьИтог();
КонецПроцедуры

&НаКлиенте
Процедура ЗапчастиКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Запчасти.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаПродажи;
	ОбновитьИтог();
КонецПроцедуры


// На клиенте оставляем только интерфейсную обертку
&НаКлиенте
Процедура ОбновитьИтог()
    ОбновитьИтогНаСервере(); 
КонецПроцедуры

// На сервере делаем тяжелую работу
&НаСервере
Процедура ОбновитьИтогНаСервере()
    ДокОбъект = РеквизитФормыВЗначение("Объект");
    РасчетРабот.ПересчитатьСуммуДокумента(ДокОбъект);
    ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры