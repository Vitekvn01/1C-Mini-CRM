Процедура ОбработкаПроведения(Отказ, Режим)       
	
	ПроверитьЗаполнение(); 
	
	Если Отказ Тогда
		Возврат; // Если есть пустые строки, дальше код даже не пойдет
	КонецЕсли;
	
	// 1. Склад
	УправлениеСкладом.СписатьЗапчасти(ЭтотОбъект, Отказ);
	
	// Если склада не хватило, прекращаем проведение
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Финансы
	УправлениеФинансами.ОтразитьВыручку(ЭтотОбъект);
	
КонецПроцедуры