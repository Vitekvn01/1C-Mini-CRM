Процедура ПередЗаписью(Отказ)
	
	ТекстОшибкиEmail = ВалидацияДанных.ПроверитьEmail(ЭтотОбъект.Email);
	
	Если ТекстОшибкиEmail <> "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибкиEmail;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;       
	
	// 2. Проверяем Email в табличной части "КонтактныеЛица"
	Для Каждого СтрокаКонтактов Из ЭтотОбъект.КонтактныеЛица Цикл
		
		ТекстОшибкиEmailТЧ = ВалидацияДанных.ПроверитьEmail(СтрокаКонтактов.Email);
		
		Если ТекстОшибкиEmailТЧ <> "" Тогда
			Сообщение = Новый СообщениеПользователю;
			// Указываем номер строки, чтобы пользователь знал, где искать ошибку
			Сообщение.Текст = "Контактные лица cтрока №" + СтрокаКонтактов.НомерСтроки + ": " + ТекстОшибкиEmailТЧ;
			Сообщение.Поле = "КонтактныеЛица[" + (СтрокаКонтактов.НомерСтроки - 1) + "].Email";			
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры