
&НаКлиенте
Процедура НоваяЗаявка(Команда)
	// Открываем форму нового документа Заявки
	ОткрытьФорму("Документ.Заявки.ФормаОбъекта");
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// 1. Считаем выручку за текущий месяц
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(Выручка.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Выручка.Обороты(&НачалоМесяца, &КонецМесяца, , ) КАК Выручка";
		
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВыручкаЗаМесяц = Выборка.Сумма;
	КонецЕсли;
	
	// 2. Считаем количество всех заявок
	Запрос2 = Новый Запрос;
	Запрос2.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Заявки.Ссылка) КАК Кол
		|ИЗ
		|	Документ.Заявки КАК Заявки";
		
	Выборка2 = Запрос2.Выполнить().Выбрать();
	Если Выборка2.Следующий() Тогда
		ВсегоЗаявок = Выборка2.Кол;
	КонецЕсли;
	
КонецПроцедуры