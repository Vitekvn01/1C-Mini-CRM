&НаКлиенте
Процедура ВыгрузитьJSON(Команда)
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Выберите период!");
		Возврат;
	КонецЕсли;
	
	// ПРОВЕРКА АДРЕСА
	Если ПустаяСтрока(АдресURL) Тогда
		ПоказатьПредупреждение(, "Укажите адрес API (URL)!");
		Возврат;
	КонецЕсли;
	
	РезультатJSON = ПолучитьJSONНаСервере(ДатаНачала, ДатаОкончания);
	ПолеJSON.УстановитьТекст(РезультатJSON); 
	
	Если НЕ ПустаяСтрока(РезультатJSON) Тогда
		Попытка
			// ПЕРЕДАЕМ ДВА ПАРАМЕТРА: JSON и Адрес
			ИнтеграцияСервер.ОтправитьДанные(РезультатJSON, АдресURL);
			ПоказатьПредупреждение(, "Данные успешно отправлены на сервер!");
		Исключение
			ПоказатьПредупреждение(, "Ошибка отправки: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция ПолучитьJSONНаСервере(ДатаС, ДатаПо)
	
	// 1. ЗАПРОС (теперь без "ПЕРВЫЕ 3" и с условием по дате)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявки.Номер,
		|	Заявки.Клиент,
		|	Заявки.ИтоговаяСумма
		|ИЗ
		|	Документ.Заявки КАК Заявки
		|ГДЕ
		|	Заявки.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
		
	// Оборачиваем в НачалоДня и КонецДня, чтобы захватить всё время суток
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПо));
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивДанных = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ДанныеЗаявки = Новый Структура;
		ДанныеЗаявки.Вставить("Номер", Выборка.Номер);
		ДанныеЗаявки.Вставить("Клиент", Строка(Выборка.Клиент)); 
		ДанныеЗаявки.Вставить("Сумма", Выборка.ИтоговаяСумма);
		
		МассивДанных.Добавить(ДанныеЗаявки);
	КонецЦикла;
	
	// 4. JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, МассивДанных); 
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции