Функция ПроверитьEmail(Email) Экспорт
    
    Если ПустаяСтрока(Email) Тогда
        Возврат "Email не может быть пустым";
    КонецЕсли;
    
    ПозицияСобаки = СтрНайти(Email, "@");
    
    Если ПозицияСобаки = 0 Тогда
        Возврат "В email отсутствует символ @";
    ИначеЕсли ПозицияСобаки = 1 Тогда
        Возврат "Символ @ не может быть первым";
    ИначеЕсли ПозицияСобаки = СтрДлина(Email) Тогда
        Возврат "Символ @ не может быть последним";
    КонецЕсли;
    
    // Проверяем, что после собаки есть точка (хоть какая-то зона)
    Если СтрНайти(Email, ".") < ПозицияСобаки Тогда
        Возврат "В email нет точки после символа @";
    КонецЕсли;
    
     Возврат "";
    
КонецФункции