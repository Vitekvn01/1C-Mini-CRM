Процедура СписатьЗапчасти(ДокументОбъект, Отказ) Экспорт
	
	// 1. Проверка остатков
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапчастиДок.Запчасть КАК Запчасть,
	|	СУММА(ЗапчастиДок.Количество) КАК Требуется,
	|	СУММА(ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) КАК ЕстьНаСкладе
	|ИЗ
	|	Документ.Заявки.Запчасти КАК ЗапчастиДок
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапчастиНаСкладе.Остатки КАК Остатки
	|	ПО ЗапчастиДок.Запчасть = Остатки.Запчасть
	|ГДЕ
	|	ЗапчастиДок.Ссылка = &Ссылка
	|	И ЗапчастиДок.Запчасть <> НЕОПРЕДЕЛЕНО
	|СГРУППИРОВАТЬ ПО
	|	ЗапчастиДок.Запчасть";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Требуется > Выборка.ЕстьНаСкладе Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает запчасти: " + Выборка.Запчасть + 
			                  ". Требуется: " + Выборка.Требуется + 
			                  ", а на складе: " + Выборка.ЕстьНаСкладе;
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Движения по расходу
	ДокументОбъект.Движения.ЗапчастиНаСкладе.Записывать = Истина;
	
	Для Каждого СтрЗапчасти Из ДокументОбъект.Запчасти Цикл
		Если НЕ ЗначениеЗаполнено(СтрЗапчасти.Запчасть) Тогда
			Продолжить; 
		КонецЕсли;
		
		ДвижениеСклад = ДокументОбъект.Движения.ЗапчастиНаСкладе.Добавить();
		ДвижениеСклад.ВидДвижения = ВидДвиженияНакопления.Расход; 
		ДвижениеСклад.Период = ДокументОбъект.Дата;
		ДвижениеСклад.Запчасть = СтрЗапчасти.Запчасть;
		ДвижениеСклад.Количество = СтрЗапчасти.Количество; 
	КонецЦикла;    
	
КонецПроцедуры

Процедура ОприходоватьЗапчасти(ДокументОбъект) Экспорт
	
	ДокументОбъект.Движения.ЗапчастиНаСкладе.Записывать = Истина;
	
	Для Каждого СтрокаТЧ Из ДокументОбъект.СписокЗапчастей Цикл
		
		// Защита от пустых строк
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Запчасть) Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = ДокументОбъект.Движения.ЗапчастиНаСкладе.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход; 
		Движение.Период = ДокументОбъект.Дата;
		Движение.Запчасть = СтрокаТЧ.Запчасть;
		Движение.Количество = СтрокаТЧ.Количество; 
	КонецЦикла;
	
КонецПроцедуры