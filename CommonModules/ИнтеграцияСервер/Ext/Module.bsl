Процедура ОтправитьДанные(ТекстJSON, АдресAPI) Экспорт
	
	Если ПустаяСтрока(АдресAPI) Тогда
		ВызватьИсключение("Не заполнен адрес API!");
	КонецЕсли;
	
	// 2. Разбираем URL на домен и путь
	ЧастиURL = СтрРазделить(СтрЗаменить(АдресAPI, "https://", ""), "/", Ложь);
	Домен = ЧастиURL[0];
	Путь = "";
	Если ЧастиURL.Количество() > 1 Тогда
		Путь = "/" + ЧастиURL[1];
	КонецЕсли;
	
	// 3. Создаем соединение (для HTTPS)
	Соединение = Новый HTTPСоединение(Домен, 443, , , , 10, Новый ЗащищенноеСоединениеOpenSSL());
	
	// 4. Формируем запрос
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(ТекстJSON);
	
	// 5. Отправляем
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение("Сервер вернул код: " + Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		ВызватьИсключение("Ошибка при отправке: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры