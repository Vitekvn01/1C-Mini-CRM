Процедура ОтразитьВыручку(ДокументОбъект) Экспорт
	
	ДокументОбъект.Движения.Выручка.Записывать = Истина;
	
	// 1. Услуги
	Для Каждого СтрРаботы Из ДокументОбъект.Работы Цикл
		Движение = ДокументОбъект.Движения.Выручка.Добавить();
		Движение.Период = ДокументОбъект.Дата;
		Движение.Клиент = ДокументОбъект.Клиент;
		Движение.Номенклатура = СтрРаботы.Услуга;
		Движение.Сумма = СтрРаботы.Сумма; 
		Движение.Себестоимость = 0;       
	КонецЦикла;
	
	// 2. Запчасти
	Для Каждого СтрЗапчасти Из ДокументОбъект.Запчасти Цикл
		Если НЕ ЗначениеЗаполнено(СтрЗапчасти.Запчасть) Тогда
			Продолжить; 
		КонецЕсли;
		
		Движение = ДокументОбъект.Движения.Выручка.Добавить();
		Движение.Период = ДокументОбъект.Дата;
		Движение.Клиент = ДокументОбъект.Клиент;
		Движение.Номенклатура = СтрЗапчасти.Запчасть;
		Движение.Сумма = СтрЗапчасти.Сумма; 
		Движение.Себестоимость = СтрЗапчасти.Количество * СтрЗапчасти.ЦенаЗакупки; 
	КонецЦикла;    
	
КонецПроцедуры